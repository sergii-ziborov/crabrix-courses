{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crabrix signed descriptor payload v1",
  "type": "object",
  "required": ["schemaVersion", "courseID", "language", "contentVersion", "archiveName", "archiveBytes", "archiveSHA256", "courseDigest", "minimumAppVersion", "requiredCapabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "courseID": {"type": "string"},
    "language": {"type": "string"},
    "contentVersion": {"type": "string"},
    "archiveName": {"type": "string"},
    "archiveBytes": {"type": "integer", "minimum": 1},
    "archiveSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "courseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minimumAppVersion": {"type": "string"},
    "requiredCapabilities": {"type": "array", "items": {"type": "string"}}
  }
}
